{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "maxSize": 4194304,
    "includes": [
      "**",
      "!**/.nish",
      "!**/dist",
      "!**/build",
      "!**/node_modules",
      "!**/tests/cases",
      "!**/bench/work",
      "!.github/.release-please-manifest.json"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "noConstantCondition": "off",
        "noUnusedFunctionParameters": "off",
        "useParseIntRadix": "off"
      },
      "complexity": {
        "useOptionalChain": "off",
        "noUselessConstructor": "off",
        "noUselessTernary": "warn",
        "noUselessContinue": "off",
        "useMathMinMax": "off"
      },
      "style": {
        "noInferrableTypes": "off",
        "useImportType": "off",
        "useNumberNamespace": "off",
        "noParameterAssign": "off",
        "noNonNullAssertion": "off",
        "useConst": "error",
        "useTemplate": "off",
        "noUselessElse": "off"
      },
      "suspicious": {
        "noShadowRestrictedNames": "warn",
        "noAssignInExpressions": "warn",
        "noVar": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/ruby/lexer.ts"],
      "linter": { "rules": { "suspicious": { "noDuplicateElseIf": "off" } } }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "markdown": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false }, "linter": { "enabled": false } }
}
