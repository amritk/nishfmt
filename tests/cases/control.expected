int classify(int n) {
  if (n < 0) {
    return -1;
  } else if (n == 0) {
    return 0;
  } else {
    return 1;
  }
}
void loops(int n) {
  for (int i = 0; i < n; ++i) {
    work(i);
  }
  while (n > 0) {
    --n;
  }
  do {
    n++;
  } while (n < 10);
  switch (n) {
  case 1:
    one();
    break;
  case 2: {
    two();
    break;
  }
  default:
    other();
  }
}
