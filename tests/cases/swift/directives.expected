import Foundation

// swiftformat:enable redundantSelf
class Foo {
    var bar = 1
    func a() {
        print(bar) // swiftformat:disable:this redundantSelf
        print(bar)
        // swiftformat:disable:next redundantSelf, trailingCommas
        print(bar)
        print(bar) /* swiftformat:disable redundantSelf */; print(bar)
        print(bar)
        // swiftformat:enable redundantSelf
        print(bar)
        let x = [
            1,
            2, // swiftformat:disable:this trailingCommas
        ]
        let y = [
            1,
            2,
        ]
        print(bar)
        // swiftformat:disable:previous redundantSelf
        if x == y {
            print(1)
        }
        // swiftformat:disable all
        if (x == y) { print( 1 ) }
        // swiftformat:enable all
        if x == y {
            print(1)
        }
        // swiftformat:disable RedundantParens spaceInsideParens
        if (x == y) {
            print( 1 )
        }
        // swiftformat:enable redundantparens -- because
        if x == y {
            print( 1 )
        }
        let s = """
          hello \(bar)
          // swiftformat:disable:next redundantSelf
          world
        """
        print(bar)
    }
}

