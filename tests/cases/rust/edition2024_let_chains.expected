// Edition 2024 parses let chains in `if` and `while`; rustfmt then writes a
// `&&` chain that holds a `let` one operand per line, unless it is just
// `ident_or_bool && let ...` (pairs.rs). Let chains in match guards parse at
// every edition.
fn f(x: Option<u32>, flag: bool) {
    if let Some(a) = x
        && a > 1
    {}
    if flag && let Some(a) = x {}
    if !flag && let Some(a) = x {}
    if true && let Some(a) = x {}
    if ::flag
        && let Some(a) = x
    {}
    if a.b
        && let Some(a) = x
    {}
    if let Some(a) = x
        && let Some(b) = y
        && a == b
    {
        work();
    }
    while let Some(a) = it.next()
        && a < 10
    {}
    match x {
        Some(a)
            if let Some(b) = f(a)
                && b > 2 => {}
        _ => {}
    }
}
